# Copy to Deployment/.env for local development. Never commit real secrets.
POSTGRES_DB=honghuang
POSTGRES_USER=honghuang
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Identity owns player credentials and login sessions. Keep its DB/user/key unique.
IDENTITY_DB_NAME=honghuang_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=replace-with-a-separate-long-random-password
IDENTITY_DATABASE_URL=postgres://identity_user:replace-with-a-separate-long-random-password@localhost:5432/honghuang_identity?sslmode=disable
IDENTITY_HTTP_ADDR=127.0.0.1:8789
IDENTITY_INTERNAL_API_KEY=replace-with-a-separate-random-service-key
IDENTITY_API_BASE=http://127.0.0.1:8789
IDENTITY_SERVICE_TOKEN=replace-with-the-same-internal-key-for-this-single-host-deployment

REDIS_PASSWORD=replace-with-another-long-random-password
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

HTTP_ADDR=:8787
ADMIN_HTTP_ADDR=127.0.0.1:8790
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
DATABASE_URL=postgres://honghuang:replace-with-a-long-random-password@localhost:5432/honghuang?sslmode=disable

# Chat is planned to move to honghuang_chat after Game-domain data access is replaced by APIs/events.
CHAT_HTTP_ADDR=:8788
CHAT_DATABASE_URL=postgres://honghuang:replace-with-a-long-random-password@localhost:5432/honghuang?sslmode=disable
REDIS_URL=redis://:replace-with-another-long-random-password@localhost:6379/0
NATS_URL=nats://localhost:4222
CHAT_NATS_URL=nats://localhost:4222
CHAT_NODE_ID=chat-local-01

WORLD_SERVER_API_KEY=replace-with-a-long-random-server-secret
BACKEND_URL=http://127.0.0.1:8787
CHAT_SERVER_URL=http://127.0.0.1:8788
WORLD_SERVER_NODE_KEY=honghuang-local-node-01
WORLD_SERVER_BIND=0.0.0.0
WORLD_SERVER_ADVERTISE_HOST=127.0.0.1
WORLD_SERVER_UDP_PORT=7777
WORLD_SERVER_REGION=local
WORLD_ID=qingyun_human
WORLD_SERVER_INSTANCE_KEY=qingyun-local-1
WORLD_SERVER_CAPACITY=100
WORLD_SERVER_OUTBOX_PATH=./data/worldserver-outbox.sqlite3
