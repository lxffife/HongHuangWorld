# Copy to Deployment/.env for local development. Never commit real secrets.
POSTGRES_DB=honghuang
POSTGRES_USER=honghuang
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-another-long-random-password
REDIS_PORT=6379

NATS_PORT=4222
NATS_MONITOR_PORT=8222

HTTP_ADDR=:8787
DATABASE_URL=postgres://honghuang:replace-with-a-long-random-password@localhost:5432/honghuang?sslmode=disable

# Standalone chat process: separate listener and connection pool. Initially points to the same
# PostgreSQL database because chat authorization reads account/session and world presence tables.
# A dedicated database can be introduced after the data ownership split.
CHAT_HTTP_ADDR=:8788
CHAT_DATABASE_URL=postgres://honghuang:replace-with-a-long-random-password@localhost:5432/honghuang?sslmode=disable
REDIS_URL=redis://:replace-with-another-long-random-password@localhost:6379/0
NATS_URL=nats://localhost:4222
# ChatServer uses this override when set; otherwise it falls back to NATS_URL.
CHAT_NATS_URL=nats://localhost:4222
# Stable and unique per ChatServer instance; keep unchanged across restarts.
CHAT_NODE_ID=chat-local-01

# Shared only between Go API and trusted world-server processes. Never ship to clients.
WORLD_SERVER_API_KEY=replace-with-a-long-random-server-secret

# WorldServer runtime configuration
BACKEND_URL=http://127.0.0.1:8787
# Standalone ChatServer listener; WorldServer chat traffic never blocks ENet simulation.
CHAT_SERVER_URL=http://127.0.0.1:8788
WORLD_SERVER_NODE_KEY=honghuang-local-node-01
WORLD_SERVER_BIND=0.0.0.0
WORLD_SERVER_ADVERTISE_HOST=127.0.0.1
WORLD_SERVER_UDP_PORT=7777
WORLD_SERVER_REGION=local
WORLD_ID=qingyun_human
WORLD_SERVER_INSTANCE_KEY=qingyun-local-1
WORLD_SERVER_CAPACITY=100
