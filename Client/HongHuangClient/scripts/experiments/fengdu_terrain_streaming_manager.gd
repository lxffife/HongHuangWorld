extends Node3D
## Incremental tile lifecycle manager for the isolated Fengdu terrain study.
## Tile geometry remains generated by the prototype's shared world-space height function.

@export var source_path: NodePath = NodePath("..")
@export var focus_path: NodePath = NodePath("../StreamingFocus")
@export_range(1, 32, 1) var tile_count := 4
@export_range(1, 256, 1) var cells_per_tile := 32
@export_range(1.0, 4096.0, 1.0) var world_size := 256.0
@export_range(0, 8, 1) var load_radius := 2
@export_range(0, 10, 1) var unload_radius := 3
@export_range(1, 8, 1) var max_operations_per_frame := 2
@export_range(0.05, 2.0, 0.05) var refresh_interval := 0.2

var _source: Node3D
var _focus: Node3D
var _active_tiles: Dictionary = {}
var _pending_load: Array[Vector2i] = []
var _pending_unload: Array[Vector2i] = []
var _refresh_accumulator := 0.0

signal tile_loaded(tile_x: int, tile_z: int)
signal tile_unloaded(tile_x: int, tile_z: int)


func _ready() -> void:
	_source = get_node_or_null(source_path) as Node3D
	_focus = get_node_or_null(focus_path) as Node3D
	if _source == null or _focus == null:
		push_warning("Terrain streaming manager needs a source node and a focus node.")
		set_process(false)
		return
	_refresh_pending_tiles()


func set_focus_world_position(world_position: Vector3) -> void:
	if is_instance_valid(_focus):
		_focus.global_position = world_position


func get_loaded_tile_count() -> int:
	return _active_tiles.size()


func _process(delta: float) -> void:
	_refresh_accumulator += delta
	if _refresh_accumulator >= refresh_interval:
		_refresh_accumulator = 0.0
		_refresh_pending_tiles()

	var operations_left := max_operations_per_frame
	while operations_left > 0:
		if not _pending_unload.is_empty():
			_unload_tile(_pending_unload.pop_back())
			operations_left -= 1
			continue
		if not _pending_load.is_empty():
			_load_tile(_pending_load.pop_front())
			operations_left -= 1
			continue
		break


func _refresh_pending_tiles() -> void:
	_pending_load.clear()
	_pending_unload.clear()
	var source_local_focus := _source.to_local(_focus.global_position)
	var focus_tile := _world_to_tile(source_local_focus)
	var desired_tiles: Dictionary = {}

	for tile_z in range(tile_count):
		for tile_x in range(tile_count):
			var tile_key := Vector2i(tile_x, tile_z)
			var distance := _tile_distance(tile_key, focus_tile)
			if distance <= load_radius:
				desired_tiles[tile_key] = true
			elif _active_tiles.has(tile_key) and distance > unload_radius:
				_pending_unload.append(tile_key)

	for tile_key in desired_tiles:
		if not _active_tiles.has(tile_key):
			_pending_load.append(tile_key)

	_pending_load.sort_custom(func(a: Vector2i, b: Vector2i) -> bool:
		return _tile_distance(a, focus_tile) < _tile_distance(b, focus_tile)
	)


func _load_tile(tile_key: Vector2i) -> void:
	if _active_tiles.has(tile_key):
		return
	var tile_variant: Variant = _source.call("_build_terrain_tile", tile_key.x, tile_key.y, cells_per_tile)
	if not tile_variant is Node3D:
		push_warning("Terrain source failed to build tile %s." % [tile_key])
		return
	var tile: Node3D = tile_variant
	add_child(tile)
	_active_tiles[tile_key] = tile
	set_meta("loaded_tile_count", _active_tiles.size())
	tile_loaded.emit(tile_key.x, tile_key.y)


func _unload_tile(tile_key: Vector2i) -> void:
	if not _active_tiles.has(tile_key):
		return
	var tile: Node3D = _active_tiles[tile_key]
	_active_tiles.erase(tile_key)
	if is_instance_valid(tile):
		tile.queue_free()
	set_meta("loaded_tile_count", _active_tiles.size())
	tile_unloaded.emit(tile_key.x, tile_key.y)


func _world_to_tile(world_position: Vector3) -> Vector2i:
	var tile_size := world_size / float(tile_count)
	return Vector2i(
		floori((world_position.x + world_size * 0.5) / tile_size),
		floori((world_position.z + world_size * 0.5) / tile_size)
	)


func _tile_distance(a: Vector2i, b: Vector2i) -> int:
	return maxi(absi(a.x - b.x), absi(a.y - b.y))
