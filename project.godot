; Engine configuration file.
; Pin and verify the exact Godot 4.x editor version in the development setup guide.

config_version=5

[application]
config/name="HongHuangClient"
run/main_scene="res://scenes/Startup.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[autoload]
HHSession="*res://scripts/session.gd"
HHChatNetwork="*res://scripts/chat_network.gd"

[rendering]
renderer/rendering_method="forward_plus"
